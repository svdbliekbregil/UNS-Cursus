[
    {
        "id": "tab-polling",
        "type": "tab",
        "label": "Polling NocoDB → UNS",
        "disabled": false,
        "info": "Sessie 4: Poll werkorders uit NocoDB, stuur via UMH Core API naar UNS.\n\nVervang BASE_ID_HIER en TABLE_ID_HIER met je eigen waarden.\nVervang XC_TOKEN_HIER met je NocoDB API token."
    },
    {
        "id": "node-inject-poll",
        "type": "inject",
        "z": "tab-polling",
        "name": "Poll elke 30s",
        "props": [],
        "repeat": "30",
        "crontab": "",
        "once": false,
        "onceDelay": "1",
        "topic": "",
        "x": 160,
        "y": 140,
        "wires": [["node-get-nocodb"]]
    },
    {
        "id": "node-get-nocodb",
        "type": "http request",
        "z": "tab-polling",
        "name": "GET NocoDB werkorders",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://nocodb:8080/api/v1/db/data/noco/BASE_ID_HIER/TABLE_ID_HIER",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [
            {"keyType": "other", "keyValue": "xc-token", "valueType": "other", "valueValue": "XC_TOKEN_HIER"}
        ],
        "x": 400,
        "y": 140,
        "wires": [["node-extract-rows"]]
    },
    {
        "id": "node-extract-rows",
        "type": "function",
        "z": "tab-polling",
        "name": "Per werkorder → UMH payload",
        "func": "var rows = msg.payload.list || [];\n\nvar messages = rows.map(function(r) {\n    return {\n        payload: {\n            event_type: \"order.created\",\n            line_id: r.asset || \"onbekend\",\n            data: {\n                id: r.order_nr,\n                product_id: r.order_nr,\n                planned_qty: r.qty || 0\n            }\n        },\n        headers: { \"Content-Type\": \"application/json\" }\n    };\n});\n\nnode.status({text: rows.length + \" werkorders → UNS\"});\nreturn [messages];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 140,
        "wires": [["node-post-to-uns", "node-debug-poll"]]
    },
    {
        "id": "node-post-to-uns",
        "type": "http request",
        "z": "tab-polling",
        "name": "POST → UMH Core API",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://umh-core:8090/api/v1/",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 640,
        "y": 220,
        "wires": [["node-debug-uns"]]
    },
    {
        "id": "node-debug-poll",
        "type": "debug",
        "z": "tab-polling",
        "name": "Werkorders",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "true",
        "targetType": "full",
        "statusVal": "topic",
        "statusType": "msg",
        "x": 860,
        "y": 140,
        "wires": []
    },
    {
        "id": "node-debug-uns",
        "type": "debug",
        "z": "tab-polling",
        "name": "UNS response",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "statusCode",
        "targetType": "msg",
        "statusVal": "statusCode",
        "statusType": "msg",
        "x": 860,
        "y": 220,
        "wires": []
    }
]
